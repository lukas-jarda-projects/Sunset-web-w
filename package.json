{
  "name": "sunset-apartment",
  "version": "0.0.1",
  "description": "Sunset Apartment - pobyt u moře",
  "productName": "Sunset-Apartment",
  "cordovaId": "",
  "author": "Lukáš Wana <wana@seznam.cz>",
  "private": true,
  "scripts": {
    "serve": "quasar dev --mode ssr",
    "serve:dorsys-quasar": "quasar dev",
    "lint": "eslint --ext .js,.vue src",
    "test": "echo \"No test specified\" && exit 0",
    "build:icons": "icongenie generate -p spa --s app-icon.png -t src/statics",
    "build:spa": "quasar build",
    "build:ssr": "quasar build --mode ssr",
    "release:dev": "yarn build:spa && yarn deploy:dev",
    "deploy:dev": "scp -r -P 22 dist/spa/* deploy@example.invalid:/srv/www-apache-webs/dorsys/www/",
    "deploy:prod": "scp -r -P 22 dist/ssr/* deploy@example.invalid:/srv/www-quasar-webs/dorsys.cz",
    "release:prod": "yarn build:ssr && yarn deploy:prod && ssh jarda@example.invalid -t -p 22 \"sudo systemctl restart dorsys.cz && sudo systemctl status dorsys.cz\"",
    "relink-lib": "rm -rf lib && junction lib c:/work/projects/altisima-central-server/src/lib"
  },
  "dependencies": {
    "@quasar/extras": "^1.9.14",
    "axios": "^0.19.2",
    "esm": "^3.2.25",
    "quasar": "^1.15.1",
    "socketio": "^1.0.0",
    "vue-i18n": "^8.0.0",
    "vue-print-nb": "1.5.0",
    "vue-timers": "^2.0.4",
    "vuelidate": "^0.7.5"
  },
  "optionalDependencies": {
    "fsevents": "2.1.3"
  },
  "devDependencies": {
    "@quasar/app": "^1.9.6",
    "@quasar/quasar-app-extension-icon-genie": "^1.1.3",
    "@vue/eslint-config-standard": "^4.0.0",
    "babel-eslint": "^10.0.1",
    "eslint": "^5.10.0",
    "eslint-loader": "^2.1.1",
    "eslint-plugin-vue": "^5.0.0",
    "prettier": "^3.9.6",
    "pug": "^2.0.4",
    "pug-plain-loader": "^1.0.0",
    "sass": "^1.32.13",
    "sass-loader": "^10.1.1"
  },
  "resolutions": {
    "@quasar/app/node-sass": "npm:sass@^1.32.13"
  },
  "engines": {
    "node": ">= 10.18.1",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "browserslist": [
    "last 1 version, not dead, ie >= 11"
  ]
}
